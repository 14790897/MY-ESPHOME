{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESPHome: run current file",
      "type": "shell",
      "command": "esphome",
      "args": [
        "run",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
